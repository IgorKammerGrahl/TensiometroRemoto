// -------------------------------------------------------------- medicao

// vdd_mv enviado ao servidor. O firmware ainda nao mede a alimentacao real;
// esta previsto um segundo divisor no GPIO35 como refinamento posterior.
// Enquanto isso vai o nominal, e a correcao ratiometrica do reprocessamento
// usa este valor.
#define VDD_MV_NOMINAL  5000

// Intervalo entre envios. A etapa 2 troca este delay() por deep sleep; em
// campo a tensao de agua no solo varia lentamente e o intervalo sera de
// dezenas de minutos.
#define INTERVALO_ENVIO_MS      60000UL

// Intervalo do MODO_CALIBRACAO.
#define INTERVALO_CALIBRACAO_MS 2000UL

// ------------------------------------------------------------- timeouts

#define WIFI_TIMEOUT_MS  20000UL
#define NTP_TIMEOUT_MS   30000UL
#define HTTP_TIMEOUT_MS  10000UL

#define NTP_SERVIDOR_1  "a.st1.ntp.br"
#define NTP_SERVIDOR_2  "pool.ntp.org"

#endif  // CONFIG_H
