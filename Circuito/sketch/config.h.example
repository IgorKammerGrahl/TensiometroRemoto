// Credenciais e parametros do no sensor.
//
// Copie para config.h e preencha. config.h esta no .gitignore: o token do
// dispositivo nao pode entrar no repositorio entregue.
//
//   cp config.h.example config.h

#ifndef CONFIG_H
#define CONFIG_H

// ---------------------------------------------------------------- modos

// MODO_CALIBRACAO: ensaio de bancada contra o vacuometro mecanico
// (objetivo especifico 5). Nao conecta Wi-Fi, nao sincroniza NTP, nao faz
// POST e NAO escreve na NVS -- so imprime CSV no serial.
//
// A calibracao le a cada poucos segundos por horas; persistir seq nesse
// regime seriam dezenas de milhares de escritas por dia na flash, sem
// proposito nenhum: o ensaio precisa de dado bruto para planilha, nao de
// telemetria.
// #define MODO_CALIBRACAO

// DEV_SEM_TLS: fala HTTP puro com um backend local, sem certificado.
// APENAS PARA DESENVOLVIMENTO. Dispara #warning em toda compilacao para
// que nenhuma build insegura passe despercebida.
// #define DEV_SEM_TLS

// ---------------------------------------------------------------- Wi-Fi

// Rede, URL da API, identidade, token e calibracao NAO moram mais aqui:
// sao gravados na NVS pelo portal cativo, no proprio aparelho, pelo
// celular. Ver "Provisionamento" no README.
//
// O que sobrou neste arquivo e o que nao muda de instalacao para
// instalacao: fisica do circuito, coeficientes, intervalos e a CA raiz.

// Senha do AP de configuracao (tensio-setup-XXXX).
//
// Ela esta documentada no README, logo e publica de fato: NAO autentica
// ninguem e nao finge autenticar. O ganho e criptografia de link -- o
// vizinho passivo nao le o token do ar sem antes associar. Minimo de 8
// caracteres, exigencia do WPA2.
#define PROV_AP_SENHA  "tensiometro"

// ------------------------------------------------------------------ TLS

// Certificado raiz da CA que assina o certificado do servidor.
//
// O valor abaixo e a ISRG Root X1 (Let's Encrypt), que serve para qualquer
// servidor atras de um Caddy/nginx com certificado automatico. Se voce usar
// outra CA, substitua pela raiz correspondente:
//
//   openssl s_client -showcerts -connect seu.dominio:443 </dev/null
//
// A validacao compara a validade do certificado contra o relogio, e por
// isso o NTP sincroniza ANTES do primeiro POST -- com o clock em 1970
// qualquer certificado valido e recusado como ainda nao emitido.
