# Configuracao do backend de telemetria.
#
# Copie para .env e gere os segredos. .env esta no .gitignore: o segredo do
# HMAC nao pode entrar no repositorio entregue.
#
#   cp .env.example .env
#
# Os quatro binarios (api, admin, seed, devtoken) leem este arquivo sozinhos
# no boot -- nao e preciso `source`. Variavel ja presente no ambiente vence o
# arquivo, para que em producao a configuracao venha do orquestrador e um
# .env esquecido no disco nao a sobrescreva.
#
# Os valores abaixo funcionam sem edicao contra o Postgres local descrito no
# README (secao Configuracao), exceto o segredo, que voce precisa gerar.

# ------------------------------------------------------------- obrigatorias

# Conexao com o Postgres de desenvolvimento. Corresponde ao container tcc-pg
# do README; o banco `telemetria` e criado la, separado do de teste.
DATABASE_URL=postgres://tcc:tcc@localhost:55432/telemetria?sslmode=disable

# SEGREDO -- GERE O SEU, nao invente um valor curto:
#
#     openssl rand -base64 32
#
# Chave do HMAC que transforma o token do no em token_hash. Trocar este valor
# invalida TODOS os tokens ja emitidos: os hashes gravados deixam de casar, e
# rotacionar exige reemitir o token de cada no e regravar o firmware.
TELEMETRIA_TOKEN_SECRET=

# ---------------------------------------------------------------- opcionais

# Porta HTTP da API. Padrao 8080 quando ausente.
PORT=8080

# Aplica as migrations no boot da API, em vez de exigir `api -migrate` antes.
# Conveniencia local apenas: com mais de uma replica subindo em paralelo, duas
# instancias correriam o goose ao mesmo tempo. Loga um aviso quando ativa.
# RUN_MIGRATIONS=true

# Emite o cookie de sessao SEM a flag Secure, aceitando HTTP puro.
#
# Deixe comentada. Existe so para demonstracao na rede local, onde a origem
# http://192.168.x.x faz o navegador descartar um cookie Secure e o login
# parece falhar sem erro. Ativar em qualquer rede nao confiavel expoe a
# sessao do produtor a quem estiver escutando.
# SESSAO_COOKIE_INSEGURO=true

# ------------------------------------------------------------------- testes

# Banco usado por `go test ./...`. Sem ela a suite de integracao e pulada.
#
# Precisa ser um banco DIFERENTE do DATABASE_URL: os testes fazem TRUNCATE em
# readings, calibrations, devices, talhoes, usuarios e sessoes entre casos.
# Apontar os dois para o mesmo banco apaga os dados de desenvolvimento.
TEST_DATABASE_URL=postgres://tcc:tcc@localhost:55432/telemetria_test?sslmode=disable
