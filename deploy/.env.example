# Configuracao do deploy. Copie para .env (que NAO e versionado) e preencha:
#
#   cp .env.example .env && chmod 600 .env
#
# docker compose le este .env sozinho, a partir deste diretorio.

# Dominio publico, com registro A apontando para o IP da VM. Sem https://.
# Modo local: localhost (ver compose.local.yaml).
DOMINIO=

# Portas publicadas pelo Caddy. Em producao NAO mude: o Let's Encrypt valida
# o dominio pelas portas 80 e 443. Na maquina local com Podman rootless, que
# nao abre porta abaixo de 1024, use 8080 e 8443.
PORTA_HTTP=80
PORTA_HTTPS=443

# Senha do Postgres. Gere com:  openssl rand -hex 24
# Hex de proposito: ela entra na DATABASE_URL, e base64 traz / e + que
# quebrariam a URL. So vale na criacao do volume do banco.
POSTGRES_PASSWORD=

# Chave do HMAC dos tokens dos nos. Gere com:  openssl rand -base64 32
# Trocar invalida TODOS os tokens emitidos: cada no precisa ser reprovisionado.
TELEMETRIA_TOKEN_SECRET=

# Copias da API atras do Caddy, todas no mesmo banco. 1 basta para o TCC;
# mais que 1 sobrevive a parada de uma delas sem perder leitura. Ate 7.
API_REPLICAS=1

# So para mais de uma instalacao na MESMA maquina (ver docs/DEPLOY.md):
# INSTANCIA nomeia o projeto e os volumes (INSTANCIA-pgdados,
# INSTANCIA-backups), REDE_OCTETO separa a rede interna (10.250.N.0/28), e
# PORTA_HTTP/PORTA_HTTPS precisam mudar tambem. Numa VM so, deixe o padrao.
INSTANCIA=tensiometro
REDE_OCTETO=250
